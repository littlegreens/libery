DATABASE_URL="postgresql://libery:libery_dev@localhost:5433/libery?schema=public"
# Opzionale: job in background (worker). Senza Redis: avvia solo libery-api (vedi deploy/ecosystem.api-only.cjs)
# REDIS_URL="redis://localhost:6379"
# In produzione con Redis condiviso: REDIS_URL="redis://127.0.0.1:6379/2"
JWT_ACCESS_SECRET="change-me-access-dev"
JWT_REFRESH_SECRET="change-me-refresh-dev"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
# Porta solo locale (Nginx fa proxy). Se 3001 è occupata: 3012, 3020, …
PORT=3001
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
ADMIN_EMAIL="admin@libery.app"
ADMIN_PASSWORD="change-me"
ADMIN_DISPLAY_NAME="admin"
GOOGLE_BOOKS_API_KEY=""

# Gmail SMTP (account invio: gab.verdini@gmail.com)
# Crea una "Password per le app" su https://myaccount.google.com/apppasswords
SMTP_FROM="gab.verdini@gmail.com"
SMTP_USER="gab.verdini@gmail.com"
SMTP_PASS=""
