generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, fuzzystrmatch, postgis_tiger_geocoder, postgis_topology]
}

enum UserRole {
  user
  point_staff
  point_manager
  admin
}

enum PointType {
  biblioteca
  libreria
  corner_free
}

enum PointStatus {
  pending
  approved
  suspended
}

enum PointBookStatus {
  active
  removed
}

enum ReservationStatus {
  active
  completed
  expired
  cancelled
}

enum TransactionType {
  take
  leave
}

enum ReportType {
  missing
  present
}

enum PointRequestStatus {
  pending
  approved
  rejected
}

enum BookSource {
  libery_db
  google_books
  open_library
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  libriExtra      Int       @default(0) @map("libri_extra")
  libriOggiUsed   Int       @default(0) @map("libri_oggi_used")
  role            UserRole  @default(user)
  emailVerifiedAt DateTime? @map("email_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  managedPoints       Point[]                  @relation("PointManager")
  pointStaffAt        PointStaff[]             @relation("PointStaffMember")
  pointStaffAdded     PointStaff[]             @relation("PointStaffAddedBy")
  aeroplanini         UserAeroplanino[]
  transactions        Transaction[]
  reservations        Reservation[]
  reports             Report[]
  pointRequests       PointRequest[]           @relation("PointRequester")
  notifications       Notification[]
  favorites           UserFavorite[]
  emailVerifications  EmailVerificationToken[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PointStaff {
  id        String   @id @default(uuid()) @db.Uuid
  pointId   String   @map("point_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  addedById String   @map("added_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  point   Point @relation(fields: [pointId], references: [id], onDelete: Cascade)
  user    User  @relation("PointStaffMember", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User  @relation("PointStaffAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([pointId, userId])
  @@index([userId])
  @@map("point_staff")
}

model UserFavorite {
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@index([userId, createdAt])
  @@map("user_favorites")
}

model UserAeroplanino {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  type     String
  earnedAt DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("user_aeroplanini")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Point {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  type           PointType
  status         PointStatus @default(pending)
  setupCompleted Boolean     @default(false) @map("setup_completed")
  managerId      String?     @map("manager_id") @db.Uuid
  address        String?
  city           String?
  latitude       Float?
  longitude      Float?
  description    String?
  openingHours   Json?       @map("opening_hours")
  photoUrl       String?     @map("photo_url")
  qrToken        String      @unique @default(uuid()) @map("qr_token")
  createdAt      DateTime    @default(now()) @map("created_at")
  approvedAt     DateTime?   @map("approved_at")
  approvedById   String?     @map("approved_by") @db.Uuid

  manager      User?         @relation("PointManager", fields: [managerId], references: [id])
  staff        PointStaff[]
  pointBooks   PointBook[]
  transactions Transaction[]

  @@map("points")
}

model Book {
  id          String     @id @default(uuid()) @db.Uuid
  isbn        String     @unique @db.VarChar(13)
  title       String
  author      String?
  publisher   String?
  year        Int?
  edition     String?
  description String?
  coverPath   String?    @map("cover_path")
  language    String?
  pages       Int?
  genre       String?
  source      BookSource @default(libery_db)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  pointBooks   PointBook[]
  transactions Transaction[]
  favorites    UserFavorite[]

  @@map("books")
}

model PointBook {
  id            String          @id @default(uuid()) @db.Uuid
  pointId       String          @map("point_id") @db.Uuid
  bookId        String          @map("book_id") @db.Uuid
  copies        Int             @default(0)
  status        PointBookStatus @default(active)
  firstAddedAt  DateTime?       @map("first_added_at")
  lastUpdatedAt DateTime        @default(now()) @updatedAt @map("last_updated_at")

  point        Point         @relation(fields: [pointId], references: [id], onDelete: Cascade)
  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  reports      Report[]

  @@unique([pointId, bookId])
  @@map("point_books")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  pointBookId String            @map("point_book_id") @db.Uuid
  status      ReservationStatus @default(active)
  expiresAt   DateTime          @map("expires_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointBook PointBook @relation(fields: [pointBookId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model Transaction {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String?         @map("user_id") @db.Uuid
  pointId   String          @map("point_id") @db.Uuid
  bookId    String          @map("book_id") @db.Uuid
  type      TransactionType
  createdAt DateTime        @default(now()) @map("created_at")

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([pointId, createdAt])
  @@index([bookId, createdAt])
  @@map("transactions")
}

model Report {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  pointBookId String     @map("point_book_id") @db.Uuid
  type        ReportType
  createdAt   DateTime   @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointBook PointBook @relation(fields: [pointBookId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model PointRequest {
  id           String             @id @default(uuid()) @db.Uuid
  requesterId  String             @map("requester_id") @db.Uuid
  pointType    PointType          @map("point_type")
  name         String
  address      String?
  city         String?
  latitude     Float?
  longitude    Float?
  description  String?
  contactEmail String?            @map("contact_email")
  contactPhone String?            @map("contact_phone")
  notes        String?
  status       PointRequestStatus @default(pending)
  adminNote    String?            @map("admin_note")
  reviewedById String?            @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?          @map("reviewed_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  requester User @relation("PointRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@map("point_requests")
}
